# Copia este archivo como .env y completa los valores.
# Puerto del servidor
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Cadena de conexión de MongoDB Atlas (si se deja vacía, la API funciona en modo demo con memoria)
MONGODB_URI=

# Chatbot Gemini (la clave solo se configura en el servidor; nunca en el frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
